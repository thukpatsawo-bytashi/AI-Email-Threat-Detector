# ── Email Ingestion (IMAP Mail Poller) ──────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_USERNAME=your-security-inbox@gmail.com
EMAIL_PASSWORD=your-app-password
POLL_INTERVAL=20
ANALYZE_API_URL=http://127.0.0.1:8000/api/analyze-text

# ── Real-Time Webhook Alerting (HIGH / CRITICAL verdicts) ────────────
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Threat Intelligence Integrations (Optional) ──────────────────────
# AbuseIPDB API key for live IP abuse confidence scoring
ABUSEIPDB_API_KEY=your-abuseipdb-api-key

# ── Persistence (Optional, defaults to backend/threat_detector.db) ──
# DATABASE_URL=sqlite:///./threat_detector.db
